# AgriGuard AI Environment Configuration
APP_NAME=AgriGuard AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpeg,jpg,png,webp

# Machine Learning Settings
DEFAULT_DEVICE=cpu
MODEL_REGISTRY_PATH=configs/models.yaml
KNOWLEDGE_BASE_PATH=src/agriguard/knowledge_base/disease_kb.json
CONFIDENCE_THRESHOLD=0.60
OOD_ENTROPY_THRESHOLD=1.80

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agriguard.log
